generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String   @unique @db.VarChar(320)
  first_name        String   @db.VarChar(100)
  last_name         String   @db.VarChar(100)
  hashed_password   String   @db.VarChar(255)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  is_active         Boolean  @default(true)
  is_email_verified Boolean  @default(false)

  credentials       Credential[]
  workflows         Workflow[]
  workflow_versions WorkflowVersion[]
  workflow_runs     WorkflowRun[]

  @@map("users")
}

model Credential {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id       String   @db.Uuid
  name           String
  provider       String
  encrypted_blob Bytes
  key_version    Int      @default(1)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  owner User @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@unique([owner_id, name], map: "uq_credentials_owner_id_name")
  @@map("credentials")
}

model Workflow {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id           String   @db.Uuid
  name               String
  description        String?
  status             String   @default("draft")
  current_version_id String?  @unique @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  owner           User             @relation(fields: [owner_id], references: [id])
  current_version WorkflowVersion? @relation("WorkflowCurrentVersion", fields: [current_version_id], references: [id])
  versions        WorkflowVersion[] @relation("WorkflowVersions")
  triggers        Trigger[]
  runs            WorkflowRun[]

  @@map("workflows")
}

model WorkflowVersion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id  String   @db.Uuid
  version      Int
  graph        Json
  settings     Json     @default("{}")
  change_note  String?
  created_by   String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  workflow    Workflow      @relation("WorkflowVersions", fields: [workflow_id], references: [id], onDelete: Cascade)
  current_for Workflow?     @relation("WorkflowCurrentVersion")
  creator     User?         @relation(fields: [created_by], references: [id])
  runs        WorkflowRun[]

  @@unique([workflow_id, version], map: "uq_workflow_versions_workflow_id_version")
  @@map("workflow_versions")
}

model Trigger {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id  String   @db.Uuid
  type         String
  config       Json     @default("{}")
  secret_hash  String?
  is_enabled   Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  workflow Workflow @relation(fields: [workflow_id], references: [id], onDelete: Cascade)

  @@map("triggers")
}

model WorkflowRun {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id         String    @db.Uuid
  workflow_version_id String    @db.Uuid
  owner_id            String    @db.Uuid
  status              String    @default("pending")
  trigger_type        String
  is_test             Boolean   @default(false)
  trigger_input       Json      @default("{}")
  output              Json?
  error               String?
  started_at          DateTime? @db.Timestamptz(6)
  finished_at         DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)

  workflow         Workflow        @relation(fields: [workflow_id], references: [id], onDelete: Cascade)
  workflow_version WorkflowVersion @relation(fields: [workflow_version_id], references: [id], onDelete: Cascade)
  owner            User            @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  node_runs        NodeRun[]

  @@index([workflow_id, created_at(sort: Desc)], map: "idx_workflow_runs_workflow_id_created_at")
  @@index([owner_id, created_at(sort: Desc)], map: "idx_workflow_runs_owner_id_created_at")
  @@map("workflow_runs")
}

model NodeRun {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id      String    @db.Uuid
  node_id     String
  node_type   String
  status      String    @default("pending")
  input       Json?
  output      Json?
  error       String?
  attempt     Int       @default(1)
  started_at  DateTime? @db.Timestamptz(6)
  finished_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  run WorkflowRun @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@index([run_id, created_at], map: "idx_node_runs_run_id_created_at")
  @@map("node_runs")
}