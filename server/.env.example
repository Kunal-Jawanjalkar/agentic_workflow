DATABASE_URL=postgresql://app:app@localhost:5432/agentic_workflow
SECRET_KEY=change-me-to-a-long-random-string
# Required: generate a dedicated 32-byte key with `openssl rand -hex 32`; keep it stable.
CREDENTIALS_ENCRYPTION_KEY='some-secret-encryption-key'
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
PORT=8001
REDIS_HOST=localhost
REDIS_PORT=6379
WORKER_ENABLED=true

# During strangler: schema changes stay in legacy/backend-python/alembic only.
# After DB changes: npm run prisma:pull && npm run prisma:generate